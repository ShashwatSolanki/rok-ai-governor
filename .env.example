# Copy this file to .env and add your Google AI Studio API key.
# Never commit .env or share your API key.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional additional key/model profiles. Profiles are tried in numeric order
# when Gemini reports quota, authentication, or model availability errors.
# GEMINI_API_KEY_1=your_first_additional_key
# GEMINI_MODEL_1=gemini-2.5-flash
# GEMINI_API_KEY_2=your_second_additional_key
# GEMINI_MODEL_2=gemini-3.5-flash-lite

# Optional model fallbacks for the first configured key (comma-separated).
# GEMINI_FALLBACK_MODELS=gemini-2.5-flash,gemini-3.5-flash-lite

# Optional provider fallbacks. Gemini profiles are tried first, then Groq,
# then OpenRouter. These providers need vision-capable models.
# GROQ_API_KEY=your_groq_api_key
# GROQ_MODEL=qwen/qwen3.8-27b
# OPENROUTER_API_KEY=your_openrouter_api_key
# OPENROUTER_MODEL=openrouter/free
