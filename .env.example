# Copy to .env. Add up to 10 Gemini keys from separate Google AI Studio projects.
# Never commit .env or share your API keys.
GEMINI_MODEL=gemini-3.8-flash
GEMINI_API_KEY_1=your_first_gemini_api_key
GEMINI_API_KEY_2=your_second_gemini_api_key
GEMINI_API_KEY_3=your_third_gemini_api_key
GEMINI_API_KEY_4=your_fourth_gemini_api_key
GEMINI_API_KEY_5=your_fifth_gemini_api_key
GEMINI_API_KEY_6=your_sixth_gemini_api_key
GEMINI_API_KEY_7=your_seventh_gemini_api_key
GEMINI_API_KEY_8=your_eighth_gemini_api_key
GEMINI_API_KEY_9=your_ninth_gemini_api_key
GEMINI_API_KEY_10=your_tenth_gemini_api_key
